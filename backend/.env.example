# Database configuration (defaults to SQLite app.db)
DATABASE_URL=sqlite:///./app.db

# Security & JWT
# Bắt buộc đặt khóa ngẫu nhiên >= 32 ký tự: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nếu để giá trị mẫu này, server KHÔNG dùng nó mà tự sinh khóa riêng tại KEYS_DIR/jwt_secret.key
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Quotas (Maximum blind sign tickets per employee per week)
WEEKLY_BLIND_SIGN_QUOTA=5

# Compliance Officer Key Storage Path
KEYS_DIR=./keys

# Local File Upload Storage
UPLOAD_DIR=./uploads

# Giới hạn tệp bằng chứng cho mỗi hồ sơ
MAX_EVIDENCE_FILE_MB=50
MAX_EVIDENCE_FILES=10

# CORS (danh sách origin, phân cách bởi dấu phẩy). Không gửi kèm cookie cho origin khác.
CORS_ORIGINS=*

# Mức log: DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# Giao diện Web Admin
# true: hiện hộp tài khoản dùng thử ở trang đăng nhập (chỉ dùng khi demo). Bản bàn giao: false
SHOW_DEMO_ACCOUNTS=false
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

# Tài liệu API /docs: false trên bản bàn giao, true khi phát triển
ENABLE_API_DOCS=false

# Chống dò mật khẩu (theo tài khoản)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# File log (xoay vòng 5 x 5 MB). Để trống để chỉ in ra màn hình. Không bao giờ ghi IP.
LOG_FILE=./logs/app.log
