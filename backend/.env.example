# Database configuration (defaults to SQLite app.db)
DATABASE_URL=sqlite:///./app.db

# Security & JWT
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Quotas (Maximum blind sign tickets per employee per week)
WEEKLY_BLIND_SIGN_QUOTA=5

# Compliance Officer Key Storage Path
KEYS_DIR=./keys

# Local File Upload Storage
UPLOAD_DIR=./uploads
