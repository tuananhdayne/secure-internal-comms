<?xml version="1.0" encoding="utf-8"?>
<!--
    Chính sách mạng của ứng dụng:
    - Cấm hoàn toàn HTTP cleartext (mọi request phải đi qua TLS).
    - Server backend dùng chứng chỉ do CA nội bộ "ATBM Dev Root CA" ký
      (sinh bằng backend/scripts/gen_dev_certs.py -> res/raw/atbm_dev_ca.pem).
    - Với các host của backend, app CHỈ tin CA nội bộ này (không tin CA hệ thống / CA người dùng cài thêm),
      nên proxy chặn bắt kiểu Burp/mitmproxy không giải mã được lưu lượng tố giác.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="@raw/atbm_dev_ca" />
        </trust-anchors>
    </domain-config>

    <!-- Chỉ bản DEBUG: tin thêm CA nội bộ với mọi địa chỉ để thử trong mạng Wi-Fi chung
         (IP LAN đổi theo DHCP nên không liệt kê cố định được; xem ./dev.sh lan).
         Bản release KHÔNG có mục này: chỉ tin CA hệ thống (Let's Encrypt). -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/atbm_dev_ca" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
